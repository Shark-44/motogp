// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  officiel
  remplacant
  wildcard
}

enum StatutGP {
  PLANIFIE
  TERMINE
  ANNULE
}

model Circuit {
  id            String @id @default(uuid())
  nom           String
  pays          String
  longueurKm    Float
  nombreVirages Int
  photo         String
  raceEvents    RaceEvent[]
}

model Rider {
  id                String @id @default(uuid())
  nom               String
  prenom            String
  pays              String
  dateAnniversaire  DateTime
  photo             String
  contracts         Contract[]
}

model Team {
  id            String  @id @default(uuid())
  nom           String
  pays          String
  constructeur  String
  estOfficielle Boolean @default(false)
  logo          String
  contracts     Contract[]
}

model Contract {
  id       String @id @default(uuid())
  saison   Int
  role     Role
  rider    Rider  @relation(fields: [piloteId], references: [id])
  piloteId String
  team     Team   @relation(fields: [equipeId], references: [id])
  equipeId String
}

model RaceEvent {
  id        String   @id @default(uuid())
  nom       String   
  saison    Int      
  date      DateTime
  statut    StatutGP
  circuit   Circuit  @relation(fields: [circuitId], references: [id])
  circuitId String
}