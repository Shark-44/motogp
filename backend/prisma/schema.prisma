// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Circuit {
  id            String @id @default(uuid())
  nom           String
  pays          String
  longueurKm    Float
  nombreVirages Int
  photo         String
}

model Rider {
  id                String @id @default(uuid())
  nom               String
  prenom            String
  pays              String
  dateAnniversaire  DateTime
  photo             String
}