DATABASE_URL="mysql://user:password@localhost:3306/motogp"
PORT=3000

# Copie ce fichier en ".env" (qui, lui, ne doit JAMAIS être commité) puis remplace les valeurs.
ADMIN_PASSWORD=remplace-moi-par-un-vrai-mot-de-passe

# Au moins 32 caractères. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplace-moi-par-une-longue-valeur-aleatoire

# Durée de validité du jeton, en secondes (3600 = 1 heure)
JWT_DUREE_SECONDES=3600
